# Copy to .env and fill in. .env is gitignored: never commit real values.

SECRET_KEY=

# Minecraft server sync (manage.py sync_server)
#
# The host, credential and file list live in a JSON config, not here, so that
# a credential never sits in the environment of every process the site spawns.
# Copy minecraft/config.example.json to mc_sync.json beside manage.py and the
# command finds it on its own. Set this only to keep it somewhere else.
MC_SYNC_CONFIG=

# Set to 0 on a host whose web workers cannot reach the game server, where the
# identical config pulls fine from a console. The page then stops dialling out
# and shows whatever a scheduled `manage.py sync_server` last left on disk.
# The management command ignores this, so the scheduled pull still runs.
MC_SYNC_WEB_PULL=1
